# ==========================================
# PORTFOLIO ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas in Production)
# Dev: mongodb://127.0.0.1:27017/portfolio
# Prod: mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Authentication Security (Generate a 64+ char random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
ADMIN_INITIAL_PASSWORD=SetAStrongPassword2026!

# Email Service (Provider-Agnostic SMTP: Gmail, SendGrid, Resend, Brevo, AWS SES, or Custom)
# Recommended provider-agnostic variables:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=zaidkhan24082006@gmail.com
EMAIL_PASSWORD=your_16_character_app_password_here
EMAIL_FROM="Mohammad Zaid Khan" <zaidkhan24082006@gmail.com>
EMAIL_TO=zaidkhan24082006@gmail.com
# EMAIL_SECURE=false # Set to true if using SSL port 465, false/omit for STARTTLS port 587

# Legacy SMTP aliases (Supported seamlessly as fallbacks)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=zaidkhan24082006@gmail.com
# SMTP_PASS=your_16_character_app_password_here
# SMTP_FROM=no-reply@mohammadzaidkhan.dev
# NOTIFICATION_EMAIL=zaidkhan24082006@gmail.com

# GitHub Integration (Optional - increases rate limits for dynamic queries)
GITHUB_TOKEN=
