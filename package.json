{
  "name": "mzk-portfolio-root",
  "version": "1.0.0",
  "description": "Mohammad Zaid Khan - Personal Developer Portfolio (Full-Stack Monorepo)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
